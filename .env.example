# ============================================
# DENGARKAN — Environment Variables
# Copy to .env and fill in values.
# Never commit .env to version control.
# ============================================

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase Transaction pooler or direct)
DATABASE_URL=postgresql://user:password@host:5432/dengarkan?sslmode=require

# ── Authentication ────────────────────────────────────────────────────────────
# Secret for signing session cookies (min 32 random bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Initial user credentials (auto-seeded on first boot)
AUTH_USERNAME=

# Argon2id hash of the password (NOT the plaintext password)
# Generate: node -e "import('argon2').then(a => a.hash('YourPassword').then(console.log))"
AUTH_PASSWORD_HASH=

# ── yt-dlp ───────────────────────────────────────────────────────────────────
# Absolute path to yt-dlp binary (default: 'yt-dlp' on PATH)
YT_DLP_PATH=yt-dlp

# Timeout in milliseconds for yt-dlp resolution (default: 30000)
YT_DLP_TIMEOUT=30000

# Optional cookies file path (e.g. cookies.txt exported from browser to bypass "Sign in to confirm you're not a bot")
# If cookies.txt is placed in the project root, it is automatically detected.
# YT_DLP_COOKIES_PATH=/path/to/cookies.txt
# YT_DLP_COOKIES_FROM_BROWSER=chrome

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0

# Set to 'true' to enable Secure flag on session cookies (required for HTTPS production).
# Use this when NODE_ENV is not 'production' but your server is behind an HTTPS reverse proxy.
# SECURE_COOKIES=true
