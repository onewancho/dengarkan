{
  "name": "@dengarkan/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/lib/seed.ts",
    "test": "node --test --import tsx/esm src/modules/auth/auth.test.ts src/infrastructure/repositories/repositories.test.ts src/modules/audio/resolver.test.ts src/modules/audio/cache.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dengarkan/shared": "workspace:*",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "argon2": "^0.41.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.36.0",
    "fastify": "^5.2.0",
    "postgres": "^3.4.0",
    "yt-search": "^2.13.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/yt-search": "^2.10.3",
    "drizzle-kit": "^0.30.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
